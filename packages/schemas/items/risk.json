{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova://items/risk",
  "title": "risk",
  "description": "Risk with mitigation",
  "type": "object",
  "properties": {
    "likelihood": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "mitigation": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    }
  },
  "required": [
    "likelihood",
    "impact"
  ],
  "additionalProperties": false
}
