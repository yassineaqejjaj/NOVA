{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova://items/initiative",
  "title": "initiative",
  "description": "Initiative contributing to an objective",
  "type": "object",
  "properties": {
    "objective_ref": {
      "type": "string"
    },
    "expected_impact": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "in_progress",
        "done"
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
