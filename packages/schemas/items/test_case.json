{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova://items/test_case",
  "title": "test_case",
  "description": "Test case or usability task",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "unit",
        "integration",
        "e2e",
        "performance",
        "security",
        "accessibility",
        "usability",
        "manual"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "steps": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false
}
