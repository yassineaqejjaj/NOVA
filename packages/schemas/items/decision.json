{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova://items/decision",
  "title": "decision",
  "description": "Decision record",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consequences": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "date": {
      "type": "string"
    }
  },
  "required": [],
  "additionalProperties": false
}
