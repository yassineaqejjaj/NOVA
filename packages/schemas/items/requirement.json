{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova://items/requirement",
  "title": "requirement",
  "description": "Functional or non-functional requirement",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "functional",
        "non_functional"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "must",
        "should",
        "could",
        "wont"
      ]
    },
    "category": {
      "type": "string"
    },
    "acceptance": {
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false
}
