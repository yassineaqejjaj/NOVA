{
  "extends": "@nova/config/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".next-e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "e2e/**/*.ts",
    "next-env.d.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
