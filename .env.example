# NOVA — copy to `.env` (cp .env.example .env). Never commit `.env`.
# In containers, infrastructure URLs are overridden by docker-compose.yml; the values below suit running on the host.

# --- Runtime ----------------------------------------------------------------------------------------
NOVA_ENV=development
NOVA_LOG_LEVEL=INFO
NOVA_PUBLIC_URL=http://localhost:3200

# --- Infrastructure ---------------------------------------------------------------------------------
NOVA_DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5435/nova
NOVA_VALKEY_URL=redis://localhost:6382/0
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova

# --- Authentication (Keycloak OIDC) --------------------------------------------------------------------
# oidc (default) | dev (local sign-in form, refused in production)
NOVA_AUTH_MODE=oidc
NOVA_OIDC_ISSUER=http://localhost:8280/realms/nova
NOVA_OIDC_CLIENT_ID=nova-web
NOVA_OIDC_CLIENT_SECRET=nova-dev-client-secret
NOVA_OIDC_AUDIENCE=nova-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Password of the demo Keycloak user `yassine` (realm import)
NOVA_DEMO_PASSWORD=nova-demo
# Required in production (>= 32 chars each): openssl rand -hex 32
NOVA_SESSION_SECRET=nova-dev-session-secret-change-me-0123456789abcdef
NOVA_SECRETS_KEY=nova-dev-secrets-key-change-me-0123456789abcdef
NOVA_COOKIE_SECURE=false

# --- LLM (open-weight, self-hosted, OpenAI-compatible) ----------------------------------------------
# vllm (guided JSON decoding) | openai_compatible (Ollama, llama.cpp server, LocalAI, TGI…)
NOVA_LLM_PROVIDER=vllm
# vLLM from `docker compose --profile gpu up` listens on :8001 on the host, vllm:8000 in the network
NOVA_LLM_BASE_URL=http://localhost:8001/v1
NOVA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
NOVA_LLM_API_KEY=
# Extra completion budget for reasoning models (Gemma 4, Qwen 3): their hidden reasoning counts against max_tokens.
NOVA_LLM_REASONING_TOKENS=0
NOVA_LLM_TIMEOUT_SECONDS=180
# Laptop alternative (Ollama):
# NOVA_LLM_PROVIDER=openai_compatible
# NOVA_LLM_BASE_URL=http://localhost:11434/v1
# NOVA_LLM_MODEL=qwen3:8b

# --- Figma (design): MCP + OAuth 2.1 needs a client id from Figma's MCP catalog; otherwise users paste a personal token (read-only)
NOVA_FIGMA_MCP_URL=https://mcp.figma.com/mcp
NOVA_FIGMA_API_URL=https://api.figma.com
NOVA_FIGMA_OAUTH_CLIENT_ID=
NOVA_FIGMA_OAUTH_CLIENT_SECRET=
# Empty: <NOVA_PUBLIC_URL>/api/v1/me/figma/callback
NOVA_FIGMA_OAUTH_REDIRECT_URI=

# --- ORBIT (context) --------------------------------------------------------------------------------
NOVA_ORBIT_BASE_URL=http://localhost:8000
NOVA_ORBIT_PUBLIC_URL=http://localhost:3000
# Service mode: per-project ORBIT agent keys "slug:orb_xxx,slug2:orb_yyy" (users normally link their own account)
NOVA_ORBIT_AGENT_KEYS=

# --- FORGE (evaluation) -----------------------------------------------------------------------------
NOVA_FORGE_BASE_URL=http://localhost:8100
NOVA_FORGE_PUBLIC_URL=http://localhost:3100
# FORGE API key (fgk_…) with role evaluator or editor — empty disables production capture
NOVA_FORGE_API_KEY=
# Bearer token FORGE sends to the NOVA Agent Protocol (configure it in FORGE's `nova` credential)
NOVA_FORGE_INBOUND_TOKEN=nova-dev-forge-inbound-token
# off | on_feedback | sampled | all
NOVA_FORGE_CAPTURE_POLICY=on_feedback
NOVA_FORGE_CAPTURE_SAMPLE_RATE=0.1
# Finished SDLC Autopilot runs are ingested by FORGE as observed runs (metrics and summaries, never code)
NOVA_FORGE_SDLC_INGEST=true
# FORGE `nova` credential id (Settings → Credentials, secret = NOVA_FORGE_INBOUND_TOKEN): FORGE uses it to call NOVA back
NOVA_FORGE_CREDENTIAL_ID=
# NOVA API URL as reachable from FORGE's runner (empty: derived from NOVA_PUBLIC_URL)
# NOVA_FORGE_NOVA_ENDPOINT=http://host.docker.internal:8200
# --- Training loop (docs/TRAINING.md): FORGE evaluates every agent on all its Skills, NOVA learns -------------
NOVA_TRAINING_ENABLED=true
# 0 = cycles started by an administrator (Team → Training with FORGE); N = automatic cycle per agent every N days
NOVA_TRAINING_INTERVAL_DAYS=0
NOVA_TRAINING_REPETITIONS=1
# 0 = every Skill of the agent; a small value keeps a first try cheap
NOVA_TRAINING_MAX_SKILLS=0
NOVA_TRAINING_AUTO_PROMOTE=true

# --- Docker Compose (container-network values; `.env` above describes the host) -----------------------
# NOVA_DOCKER_AUTH_MODE=oidc
# NOVA_DOCKER_ORBIT_BASE_URL=http://host.docker.internal:8000
# NOVA_DOCKER_FORGE_BASE_URL=http://host.docker.internal:8100
# vLLM profile (default): http://vllm:8000/v1 · Ollama on the host: http://host.docker.internal:11434/v1
# NOVA_DOCKER_LLM_BASE_URL=http://vllm:8000/v1

# --- Observability ----------------------------------------------------------------------------------
# Any OTLP/HTTP backend, e.g. http://localhost:4318 (`--profile observability` starts Jaeger)
NOVA_OTEL_EXPORTER_OTLP_ENDPOINT=
NOVA_OTEL_EXPORTER_OTLP_HEADERS=
NOVA_REDACT_PATTERNS=

# --- Policy -------------------------------------------------------------------------------------------
NOVA_POLICY_ALLOW_AUTO_EXTERNAL_WRITES=false
NOVA_POLICY_MAX_CLASSIFICATION=3
NOVA_CONTEXT_REFERENCE_RETENTION_DAYS=180

# --- Voice (speech-to-text / text-to-speech service: services/voice) -----------------------------
NOVA_VOICE_URL=http://localhost:8300
NOVA_VOICE_TOKEN=nova-dev-voice-token-0123456789

# --- Accounts (sign-up with a company address, codes by e-mail) ------------------------------------
NOVA_SIGNUP_DOMAINS=devoteam.com   # "*" = any address
NOVA_SIGNUP_EMAIL_VERIFICATION=auto   # auto | required | off
NOVA_DEMO_ACCOUNT_EMAIL=
NOVA_DEMO_ACCOUNT_PASSWORD=
# Without SMTP outside production, codes go to the dev outbox (log + GET /api/v1/auth/dev/outbox)
NOVA_SMTP_HOST=
NOVA_SMTP_PORT=587
NOVA_SMTP_USERNAME=
NOVA_SMTP_PASSWORD=
NOVA_SMTP_FROM=
